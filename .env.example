# LatentForge configuration — every variable is OPTIONAL and none are secrets.
# LatentForge needs no API keys, accounts, or external model providers.
#
# The server reads the process environment; it does not load this file by
# itself. Copy it to `.env` (which is git-ignored) and either export the
# variables in your shell or pass it to Docker:
#   docker run --env-file .env -p 4173:4173 latentforge
#
# Values below are the built-in defaults (see src/server/config.js and
# src/server/index.js). Uncomment a line only to change it.

# HTTP server
# PORT=4173
# HOST=0.0.0.0

# Absolute path to a Python 3.10-3.13 interpreter with CPU PyTorch installed.
# When unset, a local .venv is preferred, then python/python3 on PATH.
# PYTHON=/absolute/path/to/python

# Request and worker limits
# LATENTFORGE_REQUEST_TIMEOUT_MS=20000
# LATENTFORGE_MAX_QUEUE=8
# LATENTFORGE_MAX_ACTIVE=1
# LATENTFORGE_WORKER_START_TIMEOUT_MS=30000
# LATENTFORGE_WORKER_EXECUTION_TIMEOUT_MS=20000
# LATENTFORGE_MAX_WORKER_RESTART_ATTEMPTS=3

# Experiment input limits
# LATENTFORGE_MAX_TASK_LENGTH=24
# LATENTFORGE_MAX_REASONING_BUDGET=24
# LATENTFORGE_MAX_BODY_BYTES=65536
